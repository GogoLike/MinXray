---
BasedOnStyle: LLVM
IndentWidth: 4
AccessModifierOffset: -4
---
Language:        Cpp
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterCaseLabel: true
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  SplitEmptyFunction: true
  SplitEmptyRecord: true
AllowShortFunctionsOnASingleLine: None